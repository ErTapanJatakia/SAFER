# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase web client configuration for the SAFER project.
# These are public client values, not service-account credentials.
# For local development, copy this file to .env.local and replace the API key.
VITE_FIREBASE_API_KEY="REPLACE_WITH_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="safer-2026.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="safer-2026"
VITE_FIREBASE_APP_ID="1:345562773067:web:2ed2837e97c8950fb5bfce"
