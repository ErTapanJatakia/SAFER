rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // SAFER has not yet completed its UID/organisation data model or
    // authorisation tests. Deny every client read and write until the
    // tenant-scoped rules are implemented and emulator-tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
