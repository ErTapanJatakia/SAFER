rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(orgId) {
      return /databases/$(database)/documents/organisations/$(orgId)/members/$(request.auth.uid);
    }

    function organisationPath(orgId) {
      return /databases/$(database)/documents/organisations/$(orgId);
    }

    function activeTenantRole(orgId) {
      return signedIn()
        && exists(membershipPath(orgId))
        && get(membershipPath(orgId)).data.uid == request.auth.uid
        && get(membershipPath(orgId)).data.orgId == orgId
        && get(membershipPath(orgId)).data.status == 'active'
        && get(organisationPath(orgId)).data.orgId == orgId
        && get(organisationPath(orgId)).data.status == 'active';
    }

    function ownerOrAdmin(orgId) {
      return activeTenantRole(orgId)
        && get(membershipPath(orgId)).data.role in ['owner', 'admin'];
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'locale', 'themeId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 100))
        && (!('locale' in request.resource.data)
          || (request.resource.data.locale is string
            && request.resource.data.locale.matches('^[a-z]{2}(-[A-Z]{2})?$')))
        && (!('themeId' in request.resource.data)
          || (request.resource.data.themeId is string
            && request.resource.data.themeId.matches('^[a-z0-9-]{1,40}$')));
    }

    function validPersonnelData(orgId, recordId) {
      return request.resource.data.keys().hasOnly([
          'recordId', 'orgId', 'employeeRef', 'displayLabel',
          'operationalRoles', 'specialisations', 'assignmentSector',
          'readinessStatus', 'requiresHumanReview',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.keys().hasAll([
          'recordId', 'orgId', 'employeeRef', 'operationalRoles',
          'specialisations', 'assignmentSector', 'readinessStatus',
          'requiresHumanReview', 'createdAt', 'createdByUid',
          'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.recordId == recordId
        && request.resource.data.orgId == orgId
        && request.resource.data.employeeRef is string
        && request.resource.data.employeeRef.size() >= 1
        && request.resource.data.employeeRef.size() <= 64
        && (!('displayLabel' in request.resource.data)
          || (request.resource.data.displayLabel is string
            && request.resource.data.displayLabel.size() <= 80))
        && request.resource.data.operationalRoles is list
        && request.resource.data.operationalRoles.size() <= 10
        && request.resource.data.operationalRoles.hasOnly([
          'Close Protection Officer', 'Protective Security Officer',
          'Security Officer', 'Security Team Leader',
          'Security Operations Manager', 'Site Security Personnel',
          'Static Guard', 'Mobile Patrol Officer',
          'Security Driver / Protective Driver', 'Security Escort Personnel',
          'Maritime Security Personnel', 'Aviation / Airport Security',
          'Port and Terminal Security', 'Residential Security',
          'Event Security Personnel', 'Security Operations Centre Analyst',
          'Security Intelligence Analyst', 'Risk Assessment Specialist',
          'Crisis Management Coordinator', 'Incident Response Coordinator',
          'First-Aid / Medical Support Personnel', 'K9 Handler',
          'Access Control and Screening Personnel', 'Security Trainer / Instructor',
          'Security Consultant', 'Logistics and Operations Support',
          'Communications / Radio Operator', 'Cybersecurity Specialist',
          'Physical Security Systems Specialist'
        ])
        && request.resource.data.specialisations is list
        && request.resource.data.specialisations.size() <= 10
        && request.resource.data.specialisations.hasOnly([
          'Close Protection', 'Executive Protection', 'Protective Security',
          'Threat and Risk Assessment', 'Physical Security',
          'Site and Residential Security', 'Travel Risk Management',
          'Maritime Security', 'Aviation Security', 'Security Driving',
          'Crisis and Emergency Management', 'Incident Reporting',
          'Medical First Aid', 'Security Training', 'K9 Operations',
          'Access Control and Screening', 'CCTV and Physical Security Systems',
          'Security Intelligence', 'Open-Source Intelligence',
          'Cybersecurity', 'Security Operations / SOC', 'Digital Forensics',
          'Evidence Handling', 'Governance, Risk and Compliance',
          'Investigations and Documentation', 'Logistics and Operations Support',
          'Communications', 'Human Rights and Use-of-Force Compliance',
          'Language and Cultural Competence'
        ])
        && request.resource.data.assignmentSector in [
          'Sector Alpha (Metropolitan)', 'Sector Bravo (Transit)',
          'Sector Charlie (Static Facility)', 'Sector Delta (Reserve)'
        ]
        && request.resource.data.readinessStatus in [
          'DOCS_CURRENT_AWAITING_REVIEW', 'REQUIRES_HUMAN_REVIEW',
          'FLAGGED_EXPIRED_CERTS', 'UNVERIFIED_CREDENTIALS',
          'PENDING_INTAKE_DOCS'
        ]
        && request.resource.data.requiresHumanReview is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function validPersonnelCreate(orgId, recordId) {
      return validPersonnelData(orgId, recordId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validPersonnelUpdate(orgId, recordId) {
      return validPersonnelData(orgId, recordId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.orgId == resource.data.orgId;
    }

    function validIncidentData(orgId, incidentId) {
      return request.resource.data.keys().hasOnly([
          'incidentId', 'orgId', 'referenceNumber', 'incidentType',
          'dateReported', 'title', 'status', 'priority', 'summary',
          'reportedByUid', 'locationLabel',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.keys().hasAll([
          'incidentId', 'orgId', 'referenceNumber', 'incidentType',
          'dateReported', 'title', 'status', 'priority', 'summary',
          'reportedByUid', 'createdAt', 'createdByUid',
          'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.incidentId == incidentId
        && request.resource.data.orgId == orgId
        && request.resource.data.referenceNumber is string
        && request.resource.data.referenceNumber.size() >= 1
        && request.resource.data.referenceNumber.size() <= 64
        && request.resource.data.incidentType in [
          'Equipment Malfunction', 'Access Control Anomaly',
          'Communications Drop', 'Logistics Delay',
          'Medical First-Aid Event', 'Administrative Discrepancy'
        ]
        && request.resource.data.dateReported is timestamp
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 160
        && request.resource.data.status in [
          'Logged - Pending Officer Review',
          'Under Investigation / Human Review',
          'Documented & Filed'
        ]
        && request.resource.data.priority in [
          'Routine', 'Moderate', 'High Attention'
        ]
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 2000
        && request.resource.data.reportedByUid == request.auth.uid
        && (!('locationLabel' in request.resource.data)
          || (request.resource.data.locationLabel is string
            && request.resource.data.locationLabel.size() <= 120))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function validIncidentCreate(orgId, incidentId) {
      return validIncidentData(orgId, incidentId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validIncidentUpdate(orgId, incidentId) {
      return validIncidentData(orgId, incidentId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.incidentId == resource.data.incidentId
        && request.resource.data.orgId == resource.data.orgId;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validProfile(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /organisations/{orgId} {
      allow get: if ownerOrAdmin(orgId)
        && resource.data.orgId == orgId
        && resource.data.status == 'active';
      allow list, create, update, delete: if false;

      match /members/{uid} {
        allow read, write: if false;
      }

      match /personnel/{recordId} {
        allow get, list: if ownerOrAdmin(orgId)
          && resource.data.orgId == orgId;
        allow create: if ownerOrAdmin(orgId)
          && validPersonnelCreate(orgId, recordId);
        allow update: if ownerOrAdmin(orgId)
          && validPersonnelUpdate(orgId, recordId);
        allow delete: if false;
      }

      match /incidents/{incidentId} {
        allow get, list: if ownerOrAdmin(orgId)
          && resource.data.orgId == orgId;
        allow create: if ownerOrAdmin(orgId)
          && validIncidentCreate(orgId, incidentId);
        allow update: if ownerOrAdmin(orgId)
          && validIncidentUpdate(orgId, incidentId);
        allow delete: if false;
      }

      match /evidence/{evidenceId} {
        allow get, list: if ownerOrAdmin(orgId)
          && resource.data.orgId == orgId;
        allow create, update, delete: if false;
      }

      match /personnelPrivate/{recordId} {
        allow read, write: if false;
      }

      match /incidentRestricted/{incidentId} {
        allow read, write: if false;
      }

      match /auditEvents/{eventId} {
        allow read, write: if false;
      }
    }

    // Every unmodelled path, including collection-group and future paths,
    // remains inaccessible unless a later reviewed rule explicitly grants it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
